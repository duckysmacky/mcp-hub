  "query": "SELECT token.id, token.kind, token.grant_id, grants.client_id, grants.user_id,\n                grants.instance_id\n         FROM oauth_tokens AS token\n         JOIN oauth_grants AS grants ON grants.id = token.grant_id\n         WHERE token.token_hash = $1",
