  "query": "SELECT token.id, token.wrapped_dek, grants.user_id\n           FROM oauth_tokens AS token\n           JOIN oauth_grants AS grants ON grants.id = token.grant_id\n           WHERE token.token_hash = $1 AND token.kind = 'access'",
