# Public origin MCP Hub is served at (no path, no trailing slash)
# Used as the OAuth issuer and the base of every /mcp/<slug> resource URL
# Must be https, except for a loopback host
PUBLIC_URL=https://mcp-hub.example.com

# The bundled Postgres: "database" starts the compose database service
# For an external server, leave this empty and change the values below
COMPOSE_PROFILES=database

# Postgres connection
DB_HOST=database
DB_PORT=5432
DB_NAME=mcp_hub
DB_USER=mcp_hub
DB_PASSWORD=change-me
# "disable" for the bundled service, "require" or "verify-full" for a server over the internet
DB_SSLMODE=disable

# Only for building and testing with cargo. Keep this in sync with the DB_* vars
DATABASE_URL=postgres://mcp_hub:change-me@localhost:5432/mcp_hub

# Host port
HUB_PORT=8080

# Image tag pulled by docker compose
MCP_HUB_VERSION=latest

# Logging
RUST_LOG=info
