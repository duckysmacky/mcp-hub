# Public origin MCP Hub is served at (no path, no trailing slash).
# Used as the OAuth issuer and the base of every /mcp/<slug> resource URL.
# Must be https, except for a loopback host during local development.
PUBLIC_URL=http://localhost:8080

# Bundled Postgres: "database" starts the compose database service.
# Leave empty when using an external Postgres server.
COMPOSE_PROFILES=database

# Postgres connection. Use localhost for the bundled service when running the
# hub with cargo, or your server's host for an external one.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mcp_hub
DB_USER=mcp_hub
DB_PASSWORD=change-me
# "disable" for the bundled service; "require" (or "verify-full") for an external server over the internet
DB_SSLMODE=disable

# Only used for compile-time query verification and tests (sqlx). Keep in sync with the DB_* vars
DATABASE_URL=postgres://mcp_hub:change-me@localhost:5432/mcp_hub

# Address the hub binds to
BIND_ADDR=127.0.0.1:8080

# Logging
RUST_LOG=info
